# ============================================================
# Variáveis de ambiente do projeto CCF726
# Copie este arquivo para .env e preencha com os valores reais.
# O .env NÃO é versionado (ver .gitignore).
# ============================================================

# ---------- AWS (armazenamento dos dados brutos - Fase 4) ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=
S3_RAW_PREFIX=raw/

# ---------- Google Cloud Vision (OCR de imagens - extrator da fase 1) ----------
# Chave de API do Google Cloud com a Cloud Vision API ativada
# (Console > APIs e serviços > Credenciais > Criar credenciais > Chave de API)
GOOGLE_VISION_API_KEY=

# ---------- Gemini (baseline do TCC e candidato a LLM professor) ----------
GEMINI_API_KEY=
BASELINE_MODEL=gemini-2.0-flash

# ---------- LLM professor (geração/rotulagem do dataset - Fase 5) ----------
# Provedor ainda em aberto: gemini | openai | anthropic
TEACHER_PROVIDER=gemini
TEACHER_MODEL=
# Preencha apenas a chave do provedor escolhido
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- Hugging Face Hub (persistência de modelos e datasets) ----------
HF_TOKEN=
HF_MODEL_REPO=vitorvmpontes/
HF_DATASET_REPO=vitorvmpontes/

# ---------- Inferência local (Ollama) ----------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

# ---------- Crawler ----------
CRAWLER_USER_AGENT=CCF726-Crawler/0.1 (projeto academico UFV; vitor.pontes@ufv.br)
CRAWLER_DELAY_SECONDS=2

# ---------- Regras de negócio ----------
TIMEZONE=America/Sao_Paulo
